{
  "name": "@humanstandards/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Human Standards - systematic human factors validation for AI-generated interfaces",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "human-standards-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "index-docs": "node dist/indexer/index-docs.js",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "mcp",
    "human-factors",
    "accessibility",
    "wcag",
    "ux",
    "cognitive-load",
    "design-systems"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "marked": "^14.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
