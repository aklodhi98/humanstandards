{
  "name": "@humanstandards/mcp-server",
  "version": "0.3.0",
  "description": "Read-only Human Standards reference retrieval for AI-assisted interface work",
  "mcpName": "io.github.aklodhi98/human-standards",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "data/",
    "dist/index.js",
    "dist/spatial-rhythm.js",
    "dist/standards.js",
    "dist/tools/get-guidance.js",
    "dist/tools/get-standard.js",
    "LICENSE.md",
    "README.md"
  ],
  "bin": {
    "human-standards-mcp": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aklodhi98/humanstandards.git",
    "directory": "human-standards-mcp"
  },
  "homepage": "https://www.humanstandards.org/human-overview/mcp-server/",
  "bugs": {
    "url": "https://github.com/aklodhi98/humanstandards/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "index-docs": "node dist/indexer/index-docs.js",
    "test": "node --test dist/*.test.js dist/**/*.test.js",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "human-factors",
    "accessibility",
    "wcag",
    "ux",
    "cognitive-load",
    "design-systems"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "marked": "^14.1.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.14.1"
  }
}
