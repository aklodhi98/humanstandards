---
/**
 * HeroSearch - A prominent search input for the homepage hero
 * Triggers Starlight's built-in search modal when clicked or focused
 */

interface Props {
  placeholder?: string;
}

const { placeholder = "Search documentation..." } = Astro.props;
---

<div class="hero-search">
  <button
    type="button"
    class="hero-search-trigger"
    aria-label="Search documentation"
    data-open-search
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="search-icon"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <span class="search-placeholder">{placeholder}</span>
    <kbd class="search-shortcut">
      <span class="search-shortcut-key">Ctrl</span>
      <span class="search-shortcut-key">K</span>
    </kbd>
  </button>
</div>

<script>
  // Open Starlight's search modal when the hero search is clicked
  function initHeroSearch() {
    const searchTrigger = document.querySelector('[data-open-search]');

    if (searchTrigger) {
      searchTrigger.addEventListener('click', () => {
        // Find and click Starlight's search button
        const starlightSearchButton = document.querySelector('site-search button[data-open-modal]') as HTMLElement;
        if (starlightSearchButton) {
          starlightSearchButton.click();
        }
      });
    }

    // Update shortcut key display for Mac
    if (typeof navigator !== 'undefined' && navigator.platform.includes('Mac')) {
      document.querySelectorAll('.search-shortcut-key').forEach((el, i) => {
        if (i === 0 && el.textContent === 'Ctrl') {
          el.textContent = '⌘';
        }
      });
    }
  }

  // Run on DOMContentLoaded and also immediately if DOM is already ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSearch);
  } else {
    initHeroSearch();
  }
</script>

<style>
  .hero-search {
    width: 100%;
    max-width: 560px;
    margin: 2rem auto;
  }

  .hero-search-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;

    /* Appearance */
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;

    /* Typography */
    font-size: 1rem;
    color: var(--sl-color-gray-3);
    text-align: left;

    /* Interaction */
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hero-search-trigger:hover {
    border-color: var(--sl-color-gray-3);
    background: var(--sl-color-gray-6);
  }

  .hero-search-trigger:focus {
    outline: none;
    border-color: var(--sl-color-accent);
    box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.2);
  }

  .search-icon {
    flex-shrink: 0;
    color: var(--sl-color-gray-3);
  }

  .search-placeholder {
    flex: 1;
    color: var(--sl-color-gray-3);
  }

  .search-shortcut {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .search-shortcut-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.375rem;

    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;

    font-family: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }

  /* Responsive: Hide shortcut on mobile */
  @media (max-width: 480px) {
    .search-shortcut {
      display: none;
    }
  }
</style>
