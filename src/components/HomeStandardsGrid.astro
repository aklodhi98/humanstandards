---
import { Icon } from '@astrojs/starlight/components';

const standards = [
	{
		title: 'Getting Started',
		description: 'Orientation, core concepts, and how to use this library.',
		href: '/human-overview/getting-started/',
		icon: 'open-book',
		color: 'olive',
	},
	{
		title: 'Understanding Humans',
		description: 'Cognition, perception, emotions, and decision-making patterns.',
		href: '/cognition/cognitive-load/',
		icon: 'puzzle',
		color: 'blue',
	},
	{
		title: 'Design Standards',
		description: 'Evidence-backed guidance for effective, inclusive experiences.',
		href: '/accessibility/wcag-guidelines/',
		icon: 'approve-check-circle',
		color: 'green',
	},
	{
		title: 'Implementation',
		description: 'Code examples, patterns, and integration guidance.',
		href: '/examples/',
		icon: 'seti:html',
		color: 'coral',
	},
	{
		title: 'Research & References',
		description: 'Methods, publications, and further resources.',
		href: '/research-methods-metrics/usability-tests/',
		icon: 'document',
		color: 'taupe',
	},
] as const;
---

<section class="hs-library" aria-labelledby="hs-library-title">
	<p class="hs-library__eyebrow">Browse the library</p>
	<h2 id="hs-library-title">Explore the Standards</h2>

	<div class="hs-library__grid">
		{standards.map((standard) => (
			<a class="hs-library-card" href={standard.href}>
				<div class="hs-library-card__icon" aria-hidden="true">
					<Icon name={standard.icon} size="2.15rem" />
					<span class:list={['hs-library-card__dot', `is-${standard.color}`]}></span>
				</div>
				<h3>{standard.title}</h3>
				<p>{standard.description}</p>
				<Icon class="hs-library-card__arrow" name="right-arrow" size="1rem" />
			</a>
		))}
	</div>
</section>

<style>
	.hs-library {
		padding: 0 clamp(1.5rem, 5.2vw, 5rem) clamp(4rem, 8vw, 7rem);
	}

	.hs-library__eyebrow {
		margin: 0;
		color: var(--hs-accent-text);
		font-size: 0.76rem;
		font-weight: 750;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.hs-library h2 {
		margin: 0.8rem 0 clamp(2.6rem, 4vw, 3.5rem);
		color: var(--hs-ink);
		font-size: clamp(1.9rem, 2.4vw, 2.5rem);
		font-weight: 600;
		letter-spacing: -0.045em;
	}

	.hs-library__grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
	}

	.hs-library-card {
		position: relative;
		display: flex;
		min-width: 0;
		min-height: 14rem;
		padding: 0.75rem 1.25rem 0;
		flex-direction: column;
		color: var(--hs-ink);
		text-decoration: none;
		transition: background-color 160ms ease, transform 160ms ease;
	}

	.hs-library-card:first-child {
		padding-left: 0;
	}

	.hs-library-card:last-child {
		padding-right: 0;
	}

	.hs-library-card + .hs-library-card {
		border-left: 1px solid var(--hs-rule);
	}

	.hs-library-card:hover,
	.hs-library-card:focus-visible {
		background: color-mix(in srgb, var(--hs-accent) 6%, transparent);
		transform: translateY(-3px);
	}

	.hs-library-card__icon {
		position: relative;
		width: max-content;
		margin-bottom: 1.5rem;
		color: var(--hs-ink);
	}

	.hs-library-card__dot {
		position: absolute;
		right: -0.45rem;
		bottom: -0.1rem;
		width: 0.72rem;
		height: 0.72rem;
		border: 2px solid var(--hs-bg);
		border-radius: 50%;
		background: var(--hs-accent);
	}

	.hs-library-card__dot.is-blue { background: #3f56c5; }
	.hs-library-card__dot.is-green { background: #5b7a50; }
	.hs-library-card__dot.is-coral { background: #e65a45; }
	.hs-library-card__dot.is-taupe { background: #aa9b84; }

	.hs-library-card h3 {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 650;
		line-height: 1.35;
		letter-spacing: -0.02em;
	}

	.hs-library-card p {
		max-width: 15rem;
		margin: 0.8rem 0 1.5rem;
		color: var(--hs-text-muted);
		font-size: 0.875rem;
		line-height: 1.65;
	}

	.hs-library-card__arrow {
		margin-top: auto;
		transition: transform 160ms ease;
	}

	.hs-library-card:hover .hs-library-card__arrow,
	.hs-library-card:focus-visible .hs-library-card__arrow {
		transform: translateX(0.35rem);
	}

	@media (max-width: 68rem) {
		.hs-library__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0;
		}

		.hs-library-card {
			min-height: 13rem;
			padding: 2rem;
			border-top: 1px solid var(--hs-rule);
		}

		.hs-library-card:first-child,
		.hs-library-card:last-child {
			padding: 2rem;
		}

		.hs-library-card + .hs-library-card {
			border-left: 0;
		}

		.hs-library-card:nth-child(even) {
			border-left: 1px solid var(--hs-rule);
		}
	}

	@media (max-width: 38rem) {
		.hs-library__grid {
			grid-template-columns: 1fr;
		}

		.hs-library-card,
		.hs-library-card:nth-child(even),
		.hs-library-card:first-child,
		.hs-library-card:last-child {
			min-height: auto;
			padding: 1.75rem 0;
			border-left: 0;
		}
	}
</style>
